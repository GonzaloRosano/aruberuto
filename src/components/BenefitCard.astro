---
interface Props {
  num: string;
  title: string;
  body: string;
}

const { num, title, body } = Astro.props;
---
<div class="card">
  <div class="num">{num}</div>
  <h3 class="title" set:html={title} />
  <p class="body">{body}</p>
</div>

<style>
  .card {
    padding: 2.5rem;
    border-right: 1px solid var(--color-edge);
    border-bottom: 1px solid var(--color-edge);
  }

  .card:nth-child(2n) {
    border-right: none;
  }

  .card:nth-last-child(-n + 2) {
    border-bottom: none;
  }

  .num {
    font-family: var(--font-serif);
    font-size: 3rem;
    color: var(--color-edge);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .card :global(strong) {
    color: var(--color-crimson);
    font-weight: 600;
  }

  .body {
    font-size: 0.92rem;
    color: #666;
    line-height: 1.7;
    font-weight: 300;
  }

  @media (max-width: 900px) {
    .card {
      border-right: none;
    }

    .card:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--color-edge);
    }

    .card:last-child {
      border-bottom: none;
    }
  }
</style>
